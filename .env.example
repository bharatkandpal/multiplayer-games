# Local env for the container (@mpg/server). Copy to `.env.local` — the dev and
# db:* scripts load it via `node --env-file-if-exists`, and it is gitignored.
#
# Serverless (@mpg/api on Vercel) has its own vars: see apps/api/.env.example.

# --- Persistence -------------------------------------------------------------
# DATABASE_URL is the ONLY connection var the code reads. The driver is picked
# from the host: a *.neon.tech URL selects the Neon serverless (HTTP) driver,
# anything else uses pooled postgres.js. Unset => in-memory store (zero deps).
#
# Local Postgres (docker compose up -d):
DATABASE_URL=postgres://mpg:mpg_local@localhost:5432/mpg_dev
#
# Neon — use the DIRECT (non-pooler) endpoint here: the container keeps its own
# postgres.js pool, so Neon's pooler only adds a hop. The pooled (`-pooler`)
# endpoint belongs on the Vercel functions instead.
# DATABASE_URL=postgresql://neondb_owner:xxx@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Force the driver instead of auto-detecting from the host.
#   neon     -> @neondatabase/serverless HTTP driver (the Vercel functions)
#   postgres -> postgres.js pooled TCP (this container)
#
# Set this to `postgres` whenever DATABASE_URL above points at Neon. The
# auto-detect matches ANY *.neon.tech host — direct or pooled — so without the
# override the long-running container silently runs on the serverless HTTP
# driver: a fresh request per query, no warm pool, and no `.transaction()`
# support. Nothing calls `.transaction()` today, so the first code that does
# would pass on Vercel and fail only here.
# DB_DRIVER=postgres

# --- HTTP --------------------------------------------------------------------
PORT=3001
CORS_ORIGIN=*
