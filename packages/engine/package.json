{
  "name": "@mpg/engine",
  "version": "0.0.0",
  "private": true,
  "description": "Pure, shared game engine: rules, win detection, and minimax AI. Runs on client and server.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "echo \"[@mpg/engine] bundling configured later\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:fast": "vitest run --passWithNoTests --exclude '**/node_modules/**' --exclude '**/ai/difficulty.test.ts'"
  }
}
