# @mpg/web — frontend host env.

# Build-time (Vite): base URL the client's REST/socket calls target. Empty =
# same-origin (the dev proxy in vite.config.ts handles local dev). Exposed to the
# client bundle, hence the VITE_ prefix.
VITE_API_URL=https://your-backend-domain

# Runtime (serverless): the API origin the unfurl shim (api/unfurl.ts, MPG-086)
# calls to resolve a share token — GET <origin>/api/share/:token — and to build
# the og:image URL — <origin>/api/cards/:token.png. This is a *server-side* env on
# the frontend's Vercel project; it is NOT exposed to the browser.
#
# If unset, the shim degrades to serving the untouched SPA shell (a scraper gets a
# generic unfurl, a human still boots the app) — never an error. Falls back to
# API_ORIGIN, then to VITE_API_URL, if this is not set.
UNFURL_API_ORIGIN=https://your-backend-domain
