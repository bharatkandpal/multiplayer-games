{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/[...path]"
    }
  ],
  "git": {
    "deploymentEnabled": false
  },
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 15,
      "includeFiles": "api/_bundle/fonts/**"
    }
  }
}
