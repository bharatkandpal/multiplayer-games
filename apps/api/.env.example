# @mpg/api — serverless HTTP API (Vercel functions) env.
# Set these as Environment Variables on the Vercel project (Root Directory: apps/api).

# Neon Postgres connection string. Use the POOLED endpoint (host contains
# "-pooler") — serverless functions open a fresh connection per cold instance and
# must not exhaust Neon's direct-connection limit. A *.neon.tech host auto-selects
# the Neon serverless (HTTP) driver; see apps/server/src/db/index.ts.
DATABASE_URL=postgres://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Optional: force the driver instead of auto-detecting from the host.
#   neon     -> @neondatabase/serverless HTTP driver (this deployment)
#   postgres -> postgres.js pooled TCP (the container)
# DB_DRIVER=neon

# CORS allowlist: the frontend origin(s), comma-separated. REQUIRED in production —
# an unset value defaults to "*" (open API). The web client sends identity via the
# x-session-token header, so no cross-site cookies are needed.
CORS_ORIGIN=https://your-frontend-domain

# Optional: in-house rate limiter base URL. Absent = limiter disabled (no-op).
# RATE_LIMITER_URL=https://rate-limiter-seven.vercel.app
