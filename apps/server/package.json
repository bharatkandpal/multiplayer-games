{
  "name": "@mpg/server",
  "version": "0.0.0",
  "private": true,
  "description": "Authoritative Node backend: HTTP + Socket.IO, room/seat manager, server-side bots.",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/apiApp.ts"
  },
  "scripts": {
    "build": "echo \"[@mpg/server] bundling configured later\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dev": "tsx watch src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:smoke": "tsx scripts/smoke-postgres.ts"
  },
  "dependencies": {
    "@fontsource/nunito": "^5.3.0",
    "@mpg/engine": "workspace:*",
    "@neondatabase/serverless": "^0.10.0",
    "@resvg/resvg-js": "^2.6.2",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.44.0",
    "express": "^5.2.1",
    "nanoid": "^5.1.6",
    "postgres": "^3.4.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "drizzle-kit": "^0.30.0",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.20.6"
  }
}
