{
  "name": "@mpg/server",
  "version": "0.0.0",
  "private": true,
  "description": "Stateless HTTP backend: sessions, results, leaderboard, chat, and Ably token minting for peer-to-peer online play.",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/apiApp.ts",
    "./cards/fonts/*": "./src/cards/fonts/*"
  },
  "scripts": {
    "build": "echo \"[@mpg/server] bundling configured later\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:fast": "vitest run",
    "dev": "tsx watch --env-file-if-exists=../../.env.local src/index.ts",
    "db:generate": "node --env-file-if-exists=../../.env.local ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=../../.env.local ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:studio": "node --env-file-if-exists=../../.env.local ./node_modules/drizzle-kit/bin.cjs studio",
    "db:smoke": "tsx --env-file-if-exists=../../.env.local scripts/smoke-postgres.ts",
    "fonts:regen": "node scripts/regenerate-card-fonts.mjs"
  },
  "dependencies": {
    "@mpg/engine": "workspace:*",
    "@neondatabase/serverless": "^0.10.0",
    "@resvg/resvg-js": "^2.6.2",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.44.0",
    "express": "^5.2.1",
    "nanoid": "^5.1.6",
    "postgres": "^3.4.0"
  },
  "devDependencies": {
    "@fontsource/nunito": "^5.3.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.20.6",
    "wawoff2": "^2.0.1"
  }
}
